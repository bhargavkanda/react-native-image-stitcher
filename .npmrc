# Peer dependencies must be resolved by the HOST app (retailens-mobile),
# not installed nested in the SDK.  Without this flag, npm v7+ would
# auto-install react-native + react-native-vision-camera here, creating
# a duplicate TurboModule registry that blows up Jest test runs in the
# host app.  See retailens-mobile/jest.config.js for the mirror note.
legacy-peer-deps=true
