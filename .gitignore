node_modules/
dist/
*.tsbuildinfo
.DS_Store

# SwiftPM build artefacts (ios/Package.swift produces these under
# ios/.build/ when running `swift test` or `swift build`).
ios/.build/

# swift-tests/ is a SEPARATE SwiftPM package (the Mac-only XCTest harness for
# the pure-Swift pano+ lens rules). These rules arrived with it; without them
# `swift build` leaves ~2,200 artefacts staged, which is how a build directory
# ends up in a public repository.
swift-tests/.build/
swift-tests/.swiftpm/
swift-tests/Package.resolved
ios/.swiftpm/
ios/Package.resolved

# opencv-mobile XCFramework — downloaded by the podspec's prepare_command
# on pod install.  ~37 MB binary, not git-friendly.
ios/Vendor/

# Pre-built OpenCV xcframework — downloaded by postinstall-fetch-binaries
# from the matching GitHub Release (~80 MB).  Not git-friendly.
ios/Frameworks/

# OpenCV Android SDK — downloaded by build.gradle on first
# build.  ~250 MB extracted, also not git-friendly.
android/vendor/
android/build/
android/.gradle/

# Some legacy / development builds also drop the OpenCV Android SDK
# under src/main/jniLibs/.  Treat the same as android/vendor/.
android/src/main/jniLibs/

# Marker file written by scripts/postinstall-fetch-binaries.js after a
# successful binary download.  Lives next to the downloaded vendor dirs
# so re-running `npm install` skips re-fetching.
.opencv-fetched

# Android native build cache (Gradle externalNativeBuild output for the
# JNI shim libimage_stitcher.so).  Regenerated by every Gradle build.
android/.cxx/

# Shared-C++ Google Test build output (cpp/tests/ via
# scripts/run-cpp-tests.sh — CMake configure + ninja/make artefacts).
/build/

# Local-only download cache (release-binary zips, build artefacts)
.tmp/

# Implementation plans — working documents, not part of the published source.
# Kept locally for in-flight planning; release-time intent goes into CHANGELOG.md.
docs/plans/

# Architecture decision records / internal discussions — kept locally for
# reference; NOT part of the published source or npm package.
docs/decisions/

# v0.8.0 Phase 7 parity baselines — locally captured panorama JPEGs
# from v0.7.x / v0.8.0 used for SSIM comparison via
# `scripts/ssim-compare.py`.  Per-developer + per-device captures;
# not part of the release artifact.  See `docs/phase-7-parity-gate.md`.
parity-baselines/
*.parity-verification.md

# Field-build artifacts (example app). `react-native bundle --assets-dest`
# writes these into the Android source tree so `assembleDebug -PfieldBuild=true`
# packages a standalone APK. They are BUILD OUTPUT regenerated on every field
# build — committing them would put a 7 MB bundle and ~50 copied PNG/font
# assets under version control and guarantee merge conflicts.
example/android/app/src/main/assets/index.android.bundle
example/android/app/src/main/res/drawable-*/
example/android/app/src/main/res/raw/
