{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "react-native": ["../retailens-mobile/node_modules/react-native"],
      "react-native-vision-camera": [
        "../retailens-mobile/node_modules/react-native-vision-camera"
      ],
      "react-native-sensors": [
        "../retailens-mobile/node_modules/react-native-sensors"
      ],
      "rxjs": ["../retailens-mobile/node_modules/rxjs"]
    },
    "types": ["react"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
